option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: "sistema_actas.settings"
    PYTHONPATH: "/var/app/current/sistema_actas"
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: sistema_actas/staticfiles
  aws:autoscaling:launchconfiguration:
    InstanceType: t3.micro

container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && cd /var/app/current/sistema_actas && python manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "source /var/app/venv/*/bin/activate && cd /var/app/current/sistema_actas && python manage.py collectstatic --noinput"
    leader_only: true
  03_create_logs_dir:
    command: "mkdir -p /var/app/current/sistema_actas/logs"
