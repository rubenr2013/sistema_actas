option_settings:
  aws:autoscaling:launchconfiguration:
    InstanceType: t3.micro
  aws:elasticbeanstalk:application:environment:
    DEBUG: "False"
    SECRET_KEY: "CHANGE_IN_AWS_CONSOLE"
    ALLOWED_HOSTS: ".elasticbeanstalk.com,.us-east-2.elasticbeanstalk.com,localhost,127.0.0.1"
    USE_HTTPS: "false"
    CORS_ALLOW_ALL: "True"
    # Las siguientes variables DEBEN configurarse en la consola de AWS EB:
    # - EMAIL_HOST_USER
    # - EMAIL_HOST_PASSWORD
    # - DEFAULT_FROM_EMAIL
    # - DATABASE_URL
    # - GROQ_API_KEY
    # - AWS_ACCESS_KEY_ID (para S3)
    # - AWS_SECRET_ACCESS_KEY (para S3)
    # - AWS_STORAGE_BUCKET_NAME (para S3)
