.env
.env.local
.env.production
*.env
backup_data.json

# Backups de base de datos (nunca en el repo)
backups/
*.sql
*.sql.gz
db.sqlite3
db.sqlite3-journal
*.sqlite3
*.sqlite3.backup*

# -----------------------------------------------
# Python
# -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo
.Python

# Entornos virtuales
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Distribución / packaging
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

