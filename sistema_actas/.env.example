# =============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# =============================================================================
# Copia este archivo como .env y configura con tus valores reales
# NUNCA subas el archivo .env a GitHub (ya está en .gitignore)

# =============================================================================
# SEGURIDAD - CRÍTICO EN PRODUCCIÓN
# =============================================================================
# Genera una clave secreta con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=tu-secret-key-aqui-generala-con-django-minimo-50-caracteres

# En producción SIEMPRE debe ser False
DEBUG=True

# Hosts permitidos (separados por coma, sin espacios)
# Para desarrollo con ngrok agregar: .ngrok.io,.ngrok-free.app,.ngrok.app
ALLOWED_HOSTS=localhost,127.0.0.1

# Token de API - Expiración en horas (24 horas por defecto)
TOKEN_EXPIRATION_HOURS=24

# =============================================================================
# CORS - Para la app móvil Flutter
# =============================================================================
CORS_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# BASE DE DATOS
# =============================================================================
# SQLite para desarrollo, PostgreSQL para producción
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Para PostgreSQL en producción:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=sistema_actas
# DB_USER=tu_usuario
# DB_PASSWORD=tu_password_seguro
# DB_HOST=localhost
# DB_PORT=5432

# =============================================================================
# EMAIL - SMTP (Gmail)
# =============================================================================
# CREDENCIALES SENSIBLES - NO COMPARTIR
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion-16-caracteres
DEFAULT_FROM_EMAIL=Sistema Actas SENA <tu-correo@gmail.com>

# =============================================================================
# INTELIGENCIA ARTIFICIAL (GROQ)
# =============================================================================
GROQ_API_KEY=tu-groq-api-key-aqui
GROQ_MODEL=llama3-70b-8192
GROQ_TIMEOUT=30
IA_ENABLED=True
IA_DAILY_LIMIT_PER_USER=50

# Legacy (no se usa actualmente)
OPENAI_API_KEY=

# =============================================================================
# CELERY / REDIS (Tareas asíncronas)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# CONFIGURACIÓN DEL SITIO
# =============================================================================
SITE_DOMAIN=127.0.0.1:8000

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
# 1. Para Gmail, genera una "Contraseña de Aplicación":
#    - Ve a: https://myaccount.google.com/apppasswords
#    - Activa verificación en 2 pasos primero
#    - La contraseña de aplicación es de 16 caracteres (sin espacios)
#
# 2. Para producción:
#    - DEBUG=False
#    - Configura ALLOWED_HOSTS con tu dominio
#    - Usa PostgreSQL en lugar de SQLite
#    - Configura HTTPS (SECURE_SSL_REDIRECT=True)
#    - Genera un SECRET_KEY único y seguro
#
# 3. Para la app móvil Flutter:
#    - Configura CORS_ALLOWED_ORIGINS con los orígenes permitidos
#    - O usa CORS_ALLOW_ALL=True solo para desarrollo
